---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ScrollToTop from "@components/ScrollToTop.astro";
import { SITE_CONFIG } from "@config";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

// Accept props so individual pages can override the defaults
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: string;
}

const {
  title: pageTitle,
  description: pageDescription,
  ogImage,
  articleDate,
} = Astro.props;

const {
  title: defaultTitle,
  description: defaultDescription,
  siteLogo,
  navLinks,
  lang,
  author,
  socialLinks,
  socialImage: defaultSocialImage = "/home-seo.png",
  canonicalURL: siteBaseURL = "https://chungsiang.co",
} = SITE_CONFIG;

// Logic: Use page-specific content, otherwise fallback to SITE_CONFIG
const title = pageTitle ? `${pageTitle} | ${defaultTitle}` : defaultTitle;
const description = pageDescription || defaultDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteBaseURL)
  .href;
const ogImgUrl = ogImage
  ? new URL(ogImage, siteBaseURL).href
  : `${siteBaseURL}/api/og?title=${encodeURIComponent(pageTitle || defaultTitle)}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/csrounded.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImgUrl} />
    {
      articleDate && (
        <meta property="article:published_time" content={articleDate} />
      )
    }

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImgUrl} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: author,
        url: canonicalURL,
        image: ogImgUrl,
        jobTitle: "Fullstack Developer",
        sameAs: socialLinks.map((link) => link.href),
      })}
    />

    <SpeedInsights />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans font-light bg-[#101828] text-white">
    <Header siteLogo={siteLogo} navLinks={navLinks} />

    <main class="max-w-3xl px-5 mx-auto">
      <slot />
    </main>

    <Footer author={author} socialLinks={socialLinks} />
    <ScrollToTop />

    <Analytics mode="production" />
  </body>
</html>
