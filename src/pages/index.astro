---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import Projects from "@components/Projects.astro";
import TechStack from "@components/Tech-stack.astro";
import { SITE_CONTENT, techStack } from "@config";
import ImageGrid from "@components/ImageGrid.astro";
---

<Layout
  title="Homepage"
  description="Welcome to my personal website! I'm a passionate software developer with a love for creating innovative solutions. Here, you'll find information about my background, projects I've worked on, and the technologies I specialize in. Feel free to explore and learn more about me!"
>
  <Hero {...SITE_CONTENT.hero} />
  <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  <ImageGrid />
  <Projects projects={SITE_CONTENT.projects} />
  <TechStack techStack={techStack} />
</Layout>
